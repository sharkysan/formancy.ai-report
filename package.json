{
  "name": "formancy-report",
  "version": "0.2.0",
  "private": true,
  "description": "Formancy Report: paginated PDF reports, designed in native Angular and React editors, from formancy forms, Formancy Data datasets or your own JSON.",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build && node scripts/sync-licenses.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:repo": "vitest run --config vitest.repo.config.mts",
    "test:e2e:install": "node scripts/install-test.mjs",
    "test:browser": "turbo run test:browser",
    "test:pictures": "turbo run test:pictures",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.tools.json",
    "check:pkg": "turbo run check:pkg",
    "demo": "pnpm build && pnpm --filter @formancy/report-studio preview",
    "demo:deploy": "pnpm build && node scripts/demo.mjs",
    "lint": "eslint .",
    "format": "prettier --write --log-level warn '**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}'",
    "format:check": "prettier --check --log-level warn '**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}'"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "marked": "catalog:",
    "prettier": "3.9.10",
    "turbo": "2.11.2",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.1",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
