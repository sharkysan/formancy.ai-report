{
  "name": "@formancy/report-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Formancy Report Studio, the playground: edit the three starter reports in the React and the Angular builder over one session, and preview the real PDF. Never published.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "test:pictures": "node scripts/pictures.mjs --check",
    "pictures": "node scripts/pictures.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@formancy/report-builder-angular": "workspace:*",
    "@formancy/report-builder-core": "workspace:*",
    "@formancy/report-builder-react": "workspace:*",
    "@formancy/report-core": "workspace:*",
    "@formancy/report-corpus": "workspace:*",
    "@formancy/report-render-pdf": "workspace:*",
    "@formancy/report-runtime": "workspace:*",
    "@formancy/report-spec": "workspace:*",
    "@formancy/themes": "0.5.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular/build": "^22.1.8",
    "@angular/compiler": "^22.1.7",
    "@angular/compiler-cli": "^22.1.7",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "dom-accessibility-api": "^0.5.16",
    "jsdom": "^30.1.0",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.0",
    "vitest": "catalog:"
  }
}
