{
  "name": "@formancy/report-render-pdf",
  "version": "0.3.0",
  "description": "Formancy Report PDF renderer: draws a resolved report with pdfmake, with repeated table headers, page regions, kept-together blocks and embedded fonts, and refuses rather than truncates.",
  "keywords": [
    "formancy",
    "pdf",
    "pdf-generation",
    "pdf-report",
    "paginated-report",
    "invoice",
    "swiss-qr-bill",
    "qr-rechnung",
    "epc-qr-code",
    "sepa",
    "factur-x",
    "zugferd",
    "pdf-a",
    "charts",
    "source-available"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    }
  },
  "files": [
    "dist",
    "fonts",
    "LICENSE.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@formancy/report-runtime": "workspace:*",
    "echarts": "6.1.0",
    "pdfkit": "0.19.1",
    "pdfmake": "0.3.11",
    "zrender": "6.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@formancy/report-corpus": "workspace:*",
    "@types/node": "catalog:",
    "@types/pdfmake": "0.3.3",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "uqr": "0.1.3",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai-report.git",
    "directory": "packages/report-render-pdf"
  },
  "homepage": "https://formancy.ai/report/en/",
  "bugs": "https://github.com/sharkysan/formancy.ai-report/issues"
}
