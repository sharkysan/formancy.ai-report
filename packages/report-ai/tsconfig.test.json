{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The suite's own: generic.test.ts reads the files of src/turn/ from
    // disk, so it needs Node's types, which the package's own code is
    // checked without (tsconfig.json). against-formancy.test.ts holds
    // Report's types equal to formancy's, so a shape that drifts fails here.
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
