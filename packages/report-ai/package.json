{
  "name": "@formancy/report-ai",
  "version": "0.3.0",
  "description": "Formancy Report's requests of a model: a language's missing words asked for, and the answer held to the format and the compiler as one batch of report-core commands before a person sees it, on a turn in formancy's shapes -- ask, read the JSON object, ask again with the latest complaint, stop, decline, or a person carrying the turn by hand. No framework, no DOM, no Node, no network. Source-available, as every Formancy Report package.",
  "keywords": [
    "formancy",
    "report",
    "ai",
    "llm",
    "model",
    "translation",
    "source-available"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@formancy/report-core": "workspace:*",
    "@formancy/report-spec": "workspace:*",
    "@formancy/spec": "0.14.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@formancy/builder-core": "0.14.0",
    "@formancy/report-corpus": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai-report.git",
    "directory": "packages/report-ai"
  },
  "homepage": "https://formancy.ai/report/en/",
  "bugs": "https://github.com/sharkysan/formancy.ai-report/issues"
}
