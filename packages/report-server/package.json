{
  "name": "@formancy/report-server",
  "version": "0.2.0",
  "description": "Formancy Report's server: a Fastify server that verifies the host's token offline, takes the tenant from a required claim, and says what the actions table gives each person; its composition root reads its settings once.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@formancy/data-identity": "0.3.0",
    "@formancy/report-server-core": "workspace:*",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jose": "6.2.13",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai-report.git",
    "directory": "packages/report-server"
  },
  "homepage": "https://github.com/sharkysan/formancy.ai-report",
  "bugs": "https://github.com/sharkysan/formancy.ai-report/issues"
}
