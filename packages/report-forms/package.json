{
  "name": "@formancy/report-forms",
  "version": "0.2.0",
  "description": "Formancy Report's formancy form bridge: reads a report's data from a formancy form's submissions, against the exact form version that collected each, as the host hands them over. No framework, no Node, no network.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@formancy/report-runtime": "workspace:*",
    "@formancy/report-spec": "workspace:*",
    "@formancy/spec": "0.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@formancy/report-corpus": "workspace:*",
    "@formancy/report-render-pdf": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai-report.git",
    "directory": "packages/report-forms"
  },
  "homepage": "https://github.com/sharkysan/formancy.ai-report",
  "bugs": "https://github.com/sharkysan/formancy.ai-report/issues"
}
