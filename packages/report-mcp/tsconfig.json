{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // A Node program: a client launches the bin and talks down its pipes.
    // Node's types and no DOM, so a page's global in src is a compile error.
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
