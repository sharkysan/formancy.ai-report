{
  "name": "@formancy/report-builder-core",
  "version": "0.1.0",
  "description": "Formancy Report Studio's framework-independent editor model: selection, palette, outline, property definitions, page geometry, keyboard actions and drop targets over one report-core session. No framework, no DOM, no Node.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "report-builder.css",
    "LICENSE.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/sharkysan/formancy.ai-report",
  "bugs": "https://github.com/sharkysan/formancy.ai-report/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./report-builder.css": "./report-builder.css"
  },
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@formancy/report-core": "workspace:*",
    "@formancy/report-spec": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "tsdown": "catalog:",
    "unrun": "^0.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai-report.git",
    "directory": "packages/report-builder-core"
  }
}
