{
  "name": "@formancy/report-runtime",
  "version": "0.3.0",
  "description": "Formancy Report runtime: validates the data a report is given against its contracts, evaluates its expressions, groups, sorts and totals with exact decimals, formats for a locale, and lowers the result to a renderer-neutral document. No framework, no PDF engine, no Node.",
  "keywords": [
    "formancy",
    "report",
    "report-engine",
    "exact-decimal",
    "invoice",
    "e-invoice",
    "factur-x",
    "zugferd",
    "xrechnung",
    "en16931",
    "swiss-qr-bill",
    "epc-qr-code",
    "source-available"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown",
    "test:coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pkg": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@formancy/expressions": "0.12.0",
    "@formancy/report-core": "workspace:*",
    "@formancy/report-spec": "workspace:*",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharkysan/formancy.ai-report.git",
    "directory": "packages/report-runtime"
  },
  "homepage": "https://formancy.ai/report/en/",
  "bugs": "https://github.com/sharkysan/formancy.ai-report/issues"
}
