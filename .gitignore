node_modules/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store
*.log
# Except the e-invoice gate's recorded runs, the input of its judges' tests
# (0027): written with `node scripts/e-invoice.mjs --record`, and committed.
!/scripts/e-invoice/recorded/**/*.log
.vitest-reports/
test-results/
# The release report's inputs and output (0014): each job's collected
# results, the report built from them, and the tarballs the install gate
# packed. Build outputs of a run, never committed.
/release-results/
/release-report/
/release-tarballs/
# The e-invoice gate's downloads (scripts/e-invoice.mjs, 0027): each tool
# the register pins, checked by its SHA-256 where it is used, never committed.
/.e-invoice-cache/
# The demo's deploy (scripts/demo.mjs, 0018): the build staged under the
# demo's path, removed after each deploy, and Wrangler's own state.
/apps/studio/.cloudflare/
.wrangler/
# The pages' renderer, compiled for Node by their build and removed by its
# prerender once the pages are written (0021); left only by a build cut short.
/apps/pages/dist-ssr/
.idea/
.pnpm-store/

# Copied into each package at build time by scripts/sync-licenses.mjs so the
# tarballs carry them. The root LICENSE.md and NOTICE are the only real ones.
packages/*/LICENSE.md
packages/*/NOTICE

/.claude

# The delivery plan this repository started from. Kept locally for reference,
# never committed: it is a working document, not a record.
docs/plan.md
